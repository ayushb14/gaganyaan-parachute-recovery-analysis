FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     foamRun;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1000;
deltaT          1;
writeControl    timeStep;
writeInterval   250;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forceCoeffs_canopy
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (canopy);
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1.1117;
        CofR            (0 0 0);
        dragDir         (1 0 0);
        liftDir         (0 1 0);
        pitchAxis       (0 0 1);
        magUInf         20;
        lRef            25;
        Aref            490.873852123;
        executeControl  timeStep;
        executeInterval 1;
        writeControl    timeStep;
        writeInterval   20;
    }
}
